# Parametric Play Environment Configuration Template
PORT=5001
NODE_ENV=development

# Database Settings (Defaults to local SQLite database)
DATABASE_FILE=./data/parametric_play.db

# JWT & Authentication Secret
JWT_SECRET=parametric_play_jwt_secret_key_change_in_production

# Company Default Information (Editable via Admin Dashboard)
DEFAULT_COMPANY_PHONE=8102140650
DEFAULT_COMPANY_EMAIL=playparametric@gmail.com
DEFAULT_UPI_ID=parametricplay@upi

# External Payment Gateway Credentials (Optional: Activate when merchant account is approved)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# SMS & WhatsApp Notification Gateway (Optional: Fast2SMS / Twilio / Gupshup)
WHATSAPP_API_KEY=your_whatsapp_provider_api_key_here
SMS_API_KEY=your_sms_provider_api_key_here

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
